# ============================================================
# TECH ISSUE MANAGEMENT SYSTEM — ENVIRONMENT VARIABLES
# Copy this file to `.env` (frontend) and `backend/.env` (backend).
# NOTE: Never commit real secrets. These are placeholders only.
# ============================================================

# ---------------- FRONTEND (Vite / Vercel) ----------------
# Public Supabase project URL (safe to expose in the browser)
VITE_SUPABASE_URL=
# Public Supabase ANON key (safe to expose — subject to RLS)
VITE_SUPABASE_ANON_KEY=
# FastAPI backend base URL, e.g. https://your-api.onrender.com
VITE_API_URL=

# ---------------- BACKEND (FastAPI / Render / Railway) ----------------
# Supabase project URL (same as frontend)
SUPABASE_URL=
# SERVICE ROLE key — BACKEND ONLY. NEVER put this in the frontend/Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase Postgres connection string (Session Pooler recommended)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=
# SMTP configuration for notification emails (placeholders only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourcompany.com
# URL of the deployed frontend (used in emails + CORS)
FRONTEND_URL=http://localhost:5173
# Comma separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173

# ---------------- AI SIMILARITY (previous-issue recognition) ----------------
# Leave blank to use the built-in local embedding engine (no external service
# needed). To enable true semantic AI embeddings, configure an
# OpenAI-compatible embeddings API. Keys stay on the backend — NEVER in the
# frontend.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must match the pgvector column dimension in database/migration_ai_similarity.sql (default 256)
EMBEDDING_DIMENSIONS=256
# Similarity thresholds (also editable in the app: Settings → AI Similarity)
SIMILARITY_HIGH_THRESHOLD=0.90
SIMILARITY_MEDIUM_THRESHOLD=0.75
